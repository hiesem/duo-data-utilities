{
  "name": "x402-crypto-derivatives-data",
  "version": "0.3.1",
  "description": "Crypto derivatives data API client for AI agents and trading bots: perp funding rates, funding history and arbitrage, perp screener, open interest, futures basis, implied volatility, liquidations, order book depth across 8 exchanges. Pay per call with x402 (USDC on Base), no API key.",
  "keywords": [
    "crypto",
    "crypto-api",
    "derivatives",
    "perp",
    "perpetual-futures",
    "perp-funding",
    "funding-rate",
    "funding-rates",
    "funding-arbitrage",
    "perp-screener",
    "open-interest",
    "futures-basis",
    "basis",
    "implied-volatility",
    "options",
    "liquidations",
    "order-book",
    "orderbook",
    "slippage",
    "market-depth",
    "hyperliquid",
    "bybit",
    "okx",
    "deribit",
    "dydx",
    "trading-bot",
    "crypto-trading",
    "x402",
    "usdc",
    "base",
    "mcp",
    "ai-agents",
    "agent-tools",
    "pay-per-call",
    "no-api-key",
    "api-client",
    "typescript"
  ],
  "author": "Duo Data Utilities",
  "license": "MIT",
  "homepage": "https://github.com/hiesem/x402-crypto-derivatives-data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiesem/x402-crypto-derivatives-data.git"
  },
  "bugs": {
    "url": "https://github.com/hiesem/x402-crypto-derivatives-data/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
