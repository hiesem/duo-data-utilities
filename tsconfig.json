{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "duo-data-utilities": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "examples/node-basic.ts",
    "examples/supplier-onboarding-agent/*.ts",
    "examples/mcp-paid-client/*.ts",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
