{
  "name": "duo-data-utilities",
  "version": "0.1.1",
  "description": "IBAN, ISIN, VAT/tax ID and GTIN barcode validation plus 29 more pay-per-call utilities (timezone, geo, hash and more) for AI agents (x402, no API key)",
  "keywords": [
    "iban",
    "iban-validator",
    "iban-generator",
    "bban",
    "mod-97",
    "vat",
    "vat-validation",
    "vat-number",
    "tax-id",
    "national-id",
    "kyb",
    "kyc",
    "counterparty-check",
    "isin",
    "isin-validator",
    "cusip",
    "sedol",
    "figi",
    "gtin",
    "ean",
    "ean-13",
    "upc",
    "gln",
    "sscc",
    "barcode",
    "gs1",
    "checksum",
    "check-digit",
    "timezone",
    "iana",
    "dst",
    "business-days",
    "rrule",
    "rfc5545",
    "calendar",
    "hijri",
    "string-similarity",
    "levenshtein",
    "jaro-winkler",
    "soundex",
    "slug",
    "transliteration",
    "unicode",
    "confusables",
    "homoglyph",
    "hash",
    "sha256",
    "keccak",
    "punycode",
    "idn",
    "jwt",
    "jwt-decode",
    "semver",
    "url-parser",
    "geohash",
    "plus-code",
    "open-location-code",
    "point-in-polygon",
    "geodesic",
    "distance",
    "crypto-address",
    "address-validation",
    "solidity",
    "function-selector",
    "airport",
    "iata",
    "icao",
    "country",
    "iso-3166",
    "currency",
    "iso-4217",
    "nuts",
    "money-split",
    "number-to-words",
    "statistics",
    "base-conversion",
    "x402",
    "usdc",
    "base",
    "mcp",
    "ai-agents",
    "pay-per-call",
    "no-api-key"
  ],
  "author": "Duo Data Utilities",
  "license": "MIT",
  "homepage": "https://api.duoleads.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiesem/duo-data-utilities.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "npm run build",
    "test": "npm run check:generated && vitest run"
  },
  "dependencies": {
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
