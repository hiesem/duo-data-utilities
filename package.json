{
  "name": "duo-data-utilities",
  "version": "0.3.1",
  "description": "Pay-per-call data APIs for AI agents, one TypeScript client: IBAN, VAT, ISIN, GTIN validation, timezones, geo; SEO keyword data, SERP, backlinks; social media data (X/Twitter, Reddit, TikTok); crypto funding rates. x402 USDC, no API key.",
  "keywords": [
    "iban",
    "iban-validator",
    "vat",
    "vat-validation",
    "tax-id",
    "kyb",
    "isin",
    "gtin",
    "ean",
    "barcode",
    "checksum",
    "timezone",
    "business-days",
    "string-similarity",
    "transliteration",
    "geohash",
    "geodesic",
    "crypto-address",
    "function-selector",
    "iso-3166",
    "iso-4217",
    "number-to-words",
    "seo",
    "seo-api",
    "keyword-research",
    "search-volume",
    "keyword-difficulty",
    "cpc",
    "google-trends",
    "serp",
    "serp-api",
    "backlinks",
    "social-media-api",
    "social-listening",
    "twitter-api",
    "reddit-api",
    "tiktok-api",
    "youtube-transcript",
    "bluesky",
    "hacker-news",
    "crypto-derivatives",
    "perpetual-futures",
    "funding-rate",
    "funding-arbitrage",
    "open-interest",
    "implied-volatility",
    "liquidations",
    "order-book",
    "hyperliquid",
    "trading-bot",
    "x402",
    "usdc",
    "base",
    "mcp",
    "ai-agents",
    "agent-tools",
    "pay-per-call",
    "no-api-key",
    "api-client"
  ],
  "author": "Duo Data Utilities",
  "license": "MIT",
  "homepage": "https://api.duoleads.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiesem/duo-data-utilities.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs && node scripts/readme-tables.mjs",
    "check:generated": "node scripts/generate.mjs --check && node scripts/readme-tables.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "npm run build",
    "test": "npm run check:generated && vitest run"
  },
  "dependencies": {
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
