  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs && node scripts/readme-tables.mjs",
    "check:generated": "node scripts/generate.mjs --check && node scripts/readme-tables.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "npm run build",
    "test": "npm run check:generated && vitest run"
